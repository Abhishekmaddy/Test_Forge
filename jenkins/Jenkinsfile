// Enterprise Automation Framework - Jenkins Pipeline
// Minimal pipeline for a native Windows Jenkins agent (no Docker, no Slack/JIRA wiring).

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['staging', 'dev', 'prod', 'local'],
            description: 'Target environment for test execution'
        )
        string(
            name: 'TAGS',
            defaultValue: '@flipkart',
            description: 'Cucumber tags to run (e.g., @flipkart, @smoke, @regression)'
        )
        choice(
            name: 'BROWSER',
            choices: ['chromium', 'firefox', 'webkit'],
            description: 'Browser to use for testing'
        )
    }

    environment {
        ENV = "${params.ENVIRONMENT}"
        TAGS = "${params.TAGS}"
        BROWSER = "${params.BROWSER}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Tooling Check') {
            steps {
                bat 'node -v'
                bat 'npm -v'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Install Browsers') {
            steps {
                bat 'npx playwright install %BROWSER%'
            }
        }

        stage('Quality Checks') {
            steps {
                bat 'npm run typecheck'
                bat 'npm run lint'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'npm test'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/**/*', allowEmptyArchive: true, fingerprint: true
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports/allure-report',
                reportFiles: 'index.html',
                reportName: 'Allure Report'
            ])
        }
    }
}
